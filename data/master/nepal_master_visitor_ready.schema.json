{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://discovernepalhub.com/schemas/nepal-master-visitor-ready-v1.json",
  "title":"Nepal Visitor-Ready Tourism Record",
  "type":"object",
  "required":["id","province","district","name","category","geometry_type","access_status","source_file"],
  "properties":{
    "id":{"type":"string"},
    "province":{"type":"string"},
    "district":{"type":"string"},
    "name":{"type":"string"},
    "aliases":{"type":"array","items":{"type":"string"}},
    "category":{"type":"string"},
    "municipality_or_area":{"type":["string","null"]},
    "introduction":{"type":["string","null"]},
    "things_to_do":{"type":"array","items":{"type":"string"}},
    "geometry_type":{"enum":["POINT","AREA","CORRIDOR","ROUTE","WATER","PROTECTED_AREA","HOLD"]},
    "latitude":{"type":["number","null"]},
    "longitude":{"type":["number","null"]},
    "radius_m":{"type":["number","null"]},
    "coordinate_status":{"type":["string","null"]},
    "access_status":{"enum":["ROUTABLE","HUB_ONLY","ROUTING_HOLD","DYNAMIC_CHECK_REQUIRED"]},
    "main_hub":{"type":["string","null"]},
    "how_to_visit":{"type":["string","object","null"]},
    "permit_layers":{"type":"array","items":{"enum":["NONE","ENTRY_FEE","PROTECTED_AREA_ENTRY","RESTRICTED_AREA_PERMIT","CLIMBING_PERMIT","BORDER_CONTROL","OPERATOR_DEPENDENT","DYNAMIC"]}},
    "permit_note":{"type":["string","null"]},
    "dynamic_fields":{"type":"array","items":{"type":"string"}},
    "parent_entity_id":{"type":["string","null"]},
    "research_status":{"type":["string","null"]},
    "last_verified":{"type":["string","null"]},
    "source_file":{"type":"string"},
    "source_record_key":{"type":["string","null"]}
  },
  "additionalProperties":true
}
